{
  "name": "cofin",
  "version": "1.3.0",
  "description": "COFIN - Controle Financeiro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.seuapp.cofin",
    "productName": "COFIN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!~backups/**",
      "!.github/**",
      "!dev-app-update.yml",
      "!.env",
      "!.env.*",
      "!LINK MAKE.txt",
      "!Cenario_COFIN_Make.json",
      "!Iniciar COFIN.bat",
      "!*.log",
      "!*.bak"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pedrotsongas-ai",
        "repo": "COFIN",
        "releaseType": "release"
      }
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.10",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "pluggy-sdk": "^0.93.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "electron-reloader": "^1.2.3"
  }
}
